# Зразок для .env. Скопіювати й заповнити:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# Сам .env у git не потрапляє — у ньому справжні паролі. Без нього
# `docker compose up` не стартує: усі змінні нижче підставляються в
# docker-compose.yml, дефолтів у більшості з них немає.

# --- Версії ---------------------------------------------------------------
# Ядра Grav і Flarum лишаються всередині образів, тому версія фіксується тут.
PHP_VERSION=8.3
GRAV_VERSION=2.0.18
FLARUM_VERSION=^1.8

# --- Домени ---------------------------------------------------------------
# Caddy роздає сайти за цими іменами. У форку обов'язково змінити,
# інакше два проєкти на одній машині займуть ті самі адреси.
GRAV_HOST=grav.localhost
FLARUM_HOST=forum.localhost

# --- Порти на хості -------------------------------------------------------
# Імена доменів не рятують від конфлікту: порт займає перший стенд, який
# піднявся. Другому проєкту на тій самій машині потрібні інші числа.
# HTTP_PORT=80 дає чисті адреси без порту, але лише комусь одному.
HTTP_PORT=80
GRAV_PORT=8080
MAILPIT_PORT=8025

# --- Форум ----------------------------------------------------------------
FLARUM_TITLE=Forum
FLARUM_LOCALE=uk

# --- База даних (лише для Flarum) ----------------------------------------
DB_NAME=flarum
DB_USER=flarum
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Адміністратори -------------------------------------------------------
# Створюються при першому старті контейнерів.
GRAV_ADMIN_USER=admin
GRAV_ADMIN_EMAIL=admin@example.com
GRAV_ADMIN_PASSWORD=
FLARUM_ADMIN_USER=admin
FLARUM_ADMIN_EMAIL=admin@example.com
FLARUM_ADMIN_PASSWORD=

# --- Grav API -------------------------------------------------------------
# Ключ для MCP-сервера й curl. Генерується вже на живому стенді:
#   docker compose exec grav php bin/plugin api keys:generate -u admin -N "name" -n
# Показується один раз — одразу сюди і в .mcp.json.
GRAV_API_KEY=
